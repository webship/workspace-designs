{
  "name": "@webship.co/workspace-designs",
  "version": "1.0.9",
  "description": "The Designs workspace for Webship Workspace: the `designs/` folder (type sites), its settings file, its 7 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-designs.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "designs",
    "label": "Designs",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "workspace": {
      "key": "designs",
      "settingsTemplate": "config/workspace.designs.settings.yml",
      "files": [
        "commands/cmd-penpot-backup.sh",
        "commands/cmd-penpot-mcp.sh",
        "commands/cmd-penpot-project.sh",
        "commands/cmd-penpot-token.sh",
        "commands/cmd-tool-backup-design.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/designs-penpot-keeper.md"
      ],
      "skills": [
        "ai/skills/designs-workflow"
      ],
      "commands": [
        "ai/commands/designs-backup.md"
      ],
      "prompts": [
        "ai/prompts/designs-start-penpot.md"
      ]
    },
    "features": [
      "features/designs.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
